{
  "name": "codex-stream-deck",
  "version": "0.2.0",
  "private": true,
  "description": "Local macOS Elgato Stream Deck bridge for Codex task status, shortcuts and weekly usage.",
  "homepage": "https://github.com/ckundel2008/codex-stream-deck#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckundel2008/codex-stream-deck.git"
  },
  "bugs": {
    "url": "https://github.com/ckundel2008/codex-stream-deck/issues"
  },
  "type": "module",
  "bin": {
    "codex-micro-emulator": "bin/codex-micro-emulator.js",
    "codex-stream-deck": "bin/codex-streamdeck-direct.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "scripts": {
    "test": "node --test",
    "start": "node bin/codex-streamdeck-direct.js",
    "doctor": "node bin/doctor.js",
    "install:autostart": "zsh bin/install-autostart.sh",
    "uninstall:autostart": "zsh bin/uninstall-autostart.sh",
    "start:legacy": "node bin/codex-micro-emulator.js",
    "build:native": "bash native/CodexMicroVirtualHID/build.sh"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "optionalDependencies": {
    "@elgato-stream-deck/node": "^7.1.0",
    "sharp": "^0.35.4",
    "lucide-static": "^0.460.0"
  },
  "keywords": [
    "codex",
    "stream-deck",
    "elgato",
    "macos",
    "desktop-automation",
    "task-status",
    "codex-desktop",
    "weekly-usage",
    "local-first"
  ],
  "license": "MIT"
}
